# Ambiente: development | test | production
NODE_ENV=development
# Segredo do token CSRF. Gerar com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CSRF_SECRET=
USERS_FILE=data/usuarios.example.json


# Em produção, sempre 127.0.0.1 (o IIS fica na frente)
HOST=127.0.0.1
PORT=3000

# Endereço que o navegador usa para acessar o serviço
PUBLIC_URL=http://localhost:3000